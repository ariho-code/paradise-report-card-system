# Neon connection string (pooled) for Vercel, or local Postgres for development.
# Local docker: postgresql://paradise:paradise@127.0.0.1:5433/paradise
# Neon:        postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://paradise:paradise@127.0.0.1:5433/paradise

# Random 32+ character string. Required in production.
AUTH_SECRET=replace-with-a-long-random-string

# Server-side only. Never commit the real key. Used to draft character + teacher comments.
DEEPSEEK_API_KEY=
